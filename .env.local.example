# Copy this file to .env.local (and add the same values in Vercel -> Settings -> Environment Variables)

NEXT_PUBLIC_SUPABASE_URL=https://ogzupulwrqismtlwhtos.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_lxtY5_qclxJEmfjw0Et6iQ_rf2KpT3g

# Only needed for scripts/sync-sleeper.ts (server-side writes bypass RLS).
# Get this from Supabase dashboard -> Project Settings -> API -> service_role key.
# NEVER expose this with a NEXT_PUBLIC_ prefix or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Your Dyno Mites league's Sleeper league ID for the CURRENT season.
# Remember: Sleeper issues a new league_id every season, chained via previous_league_id.
SLEEPER_LEAGUE_ID=1314667784856170496

# Make up any password-like string here. It's what stops a random visitor
# from triggering /api/sync -- you'll type it into the URL, not share it.
SYNC_SECRET=
